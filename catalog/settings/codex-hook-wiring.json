{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash <HOOK_DIR_SHELL>/after-commit-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash <HOOK_DIR_SHELL>/optimizer-nudge.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
